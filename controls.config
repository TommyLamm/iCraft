# =====================================================================
# iCraft 玩家按鍵設定檔 (Keybindings Configuration)
# =====================================================================
# 本檔案供玩家自由修改遊戲內的所有按鍵綁定。
# 修改存檔後，啟動遊戲將自動載入最新按鍵設定。
#
# 【支援的按鍵名稱 (Supported Key Names)】:
#   - 字母鍵: A, B, C, ..., Z
#   - 數字鍵: 0, 1, 2, ..., 9
#   - 方向鍵: UP, DOWN, LEFT, RIGHT
#   - 修飾鍵: SPACE, LCTRL, RCTRL, LSHIFT, RSHIFT
#   - 控制鍵: ESC, ENTER, TAB, BACKSPACE, F1 ~ F12
# =====================================================================

# ---------------------------------------------------------------------
# 1. 角色移動與基本操作 (Movement & Basic Actions)
# ---------------------------------------------------------------------

# 前進 (Move Forward)
key_forward = W

# 後退 (Move Backward)
key_backward = S

# 向左平移 (Move Left)
key_left = A

# 向右平移 (Move Right)
key_right = D

# 跳躍 / 創造模式向上飛行 (Jump / Ascend)
key_jump = SPACE

# 疾跑 (Sprint)
key_sprint = LCTRL

# 潛行 / 創造模式向下滑行 (Sneak / Descend)
key_sneak = LSHIFT

# 開啟 / 關閉背包 (Toggle Inventory)
key_inventory = E

# ---------------------------------------------------------------------
# 2. 系統功能與模式切換快捷鍵 (System & Gameplay Hotkeys)
# ---------------------------------------------------------------------

# 開啟 / 關閉聊天框 (Open Chat)
key_chat = T

# 時間加速 (Accelerate Time)
key_time_speed = F

# 開啟 / 關閉成就樹 (Advancements Screen)
key_advancements = L

# 開啟 / 關閉 F3 偵錯 Overlay (Debug Info)
key_debug = F3

# 切換第一人稱 / 第三人稱視角 (Toggle Camera View)
key_perspective = F5

# 切換生存 / 創造遊戲模式 (Toggle Game Mode)
key_gamemode = G

# 暫停選單 / 關閉界面 (Pause Menu / Close UI)
key_pause = ESC

# ---------------------------------------------------------------------
# 3. 快捷欄物品選擇 1 - 9 (Hotbar Item Selection 1-9)
# ---------------------------------------------------------------------

key_hotbar_1 = 1
key_hotbar_2 = 2
key_hotbar_3 = 3
key_hotbar_4 = 4
key_hotbar_5 = 5
key_hotbar_6 = 6
key_hotbar_7 = 7
key_hotbar_8 = 8
key_hotbar_9 = 9
